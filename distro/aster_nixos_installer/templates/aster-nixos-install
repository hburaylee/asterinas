#!/bin/sh

# SPDX-License-Identifier: MPL-2.0

set -e

# Default values
CONFIG_PATH=""
DISK=""
IMAGE=""
FORCE_FORMAT_DISK=false

# Function to display help
show_help() {
    cat << EOF
Usage:
$0 --config <CONFIG_PATH> --disk <DISK> [--force-format-disk]
$0 --config <CONFIG_PATH> --image <IMAGE_PATH>
$0 [-h | --help]

Options:
  --config <CONFIG_PATH>      Path to the configuration file.
  --disk <DISK>               Target block device for installation (e.g., /dev/sda).
  --image <IMAGE_PATH>        Target disk image file; installs without loop devices.
  --force-format-disk         Forcefully format the specified disk (DANGEROUS!).
  -h, --help                  Show this help message.

Examples:
  $0 --config ./distro/configuration.nix --disk /dev/vda --force-format-disk
  $0 --config ./distro/configuration.nix --image ./asterinas.img
EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config)
            if [[ -z "$2" ]] || [[ "$2" == -* ]]; then
                echo "Error: --config requires a non-empty argument." >&2
                exit 1
            fi
            CONFIG_PATH="$2"
            shift 2
            ;;
        --disk)
            if [[ -z "$2" ]] || [[ "$2" == -* ]]; then
                echo "Error: --disk requires a non-empty argument." >&2
                exit 1
            fi
            DISK="$2"
            shift 2
            ;;
        --image)
            if [[ -z "$2" ]] || [[ "$2" == -* ]]; then
                echo "Error: --image requires a non-empty argument." >&2
                exit 1
            fi
            IMAGE="$2"
            shift 2
            ;;
        --force-format-disk)
            FORCE_FORMAT_DISK=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            show_help
            exit 1
            ;;
    esac
done

# Validate required arguments
if [[ -z "$CONFIG_PATH" ]]; then
    echo "Error: --config is required." >&2
    exit 1
fi

if [[ -n "$DISK" && -n "$IMAGE" ]]; then
    echo "Error: --disk and --image are mutually exclusive." >&2
    exit 1
fi

if [[ -z "$DISK" && -z "$IMAGE" ]]; then
    echo "Error: either --disk or --image is required." >&2
    exit 1
fi

# Install NixOS directly into a disk image file without using loop devices.
# The image is partitioned and populated with parted/mkfs/mcopy/dd.
install_to_image() {
    local IMAGE=$1
    local CONFIG_PATH=$2

    echo "Installing Asterinas NixOS into ${IMAGE} without loop devices."

    local BUILD_DIR ESP_IMG ESP_CONTENT_DIR ROOT_IMG
    BUILD_DIR=$(mktemp -d /tmp/aster-nixos-install.XXXXXX)
    # Nix needs to read the configuration files under BUILD_DIR while building
    # the system closure, so the directory must be traversable.
    chmod 755 "${BUILD_DIR}"
    ESP_IMG=$(mktemp /tmp/aster-nixos-esp.XXXXXX.img)
    ESP_CONTENT_DIR=$(mktemp -d /tmp/aster-nixos-esp-content.XXXXXX)
    ROOT_IMG=$(mktemp /tmp/aster-nixos-root.XXXXXX.img)

    cleanup_image() {
        rm -f "${ESP_IMG}" "${ROOT_IMG}"
        rm -rf "${BUILD_DIR}" "${ESP_CONTENT_DIR}"
    }
    trap cleanup_image EXIT INT TERM ERR

    # Create a GPT partition table directly inside the image file.
    parted -s "${IMAGE}" -- mklabel gpt
    parted -s "${IMAGE}" -- mkpart ESP fat32 1MB 512MB
    parted -s "${IMAGE}" -- mkpart root ext2 512MB 100%
    parted -s "${IMAGE}" -- set 1 esp on

    # Read the byte offsets and sizes that parted actually assigned.
    local PART_INFO ESP_START ESP_SIZE ROOT_START ROOT_SIZE
    PART_INFO=$(parted -s -m "${IMAGE}" unit B print | awk -F: '
        /^1:/ { gsub(/B$/, "", $2); gsub(/B$/, "", $4); esp_start=$2; esp_size=$4 }
        /^2:/ { gsub(/B$/, "", $2); gsub(/B$/, "", $4); root_start=$2; root_size=$4 }
        END { print esp_start, esp_size, root_start, root_size }')

    read -r ESP_START ESP_SIZE ROOT_START ROOT_SIZE <<< "${PART_INFO}"
    if [[ -z "${ESP_START}" || -z "${ESP_SIZE}" || -z "${ROOT_START}" || -z "${ROOT_SIZE}" ]]; then
        echo "Error: failed to parse partitions from ${IMAGE}." >&2
        exit 1
    fi

    # Populate a staging directory exactly like the block-device path.
    mkdir -p "${BUILD_DIR}/boot" "${BUILD_DIR}/tmp" "${BUILD_DIR}/etc/nixos"
    chmod 1777 "${BUILD_DIR}/tmp"

    cp "${CONFIG_PATH}" "${BUILD_DIR}/etc/nixos/configuration.nix"
    cp @aster-configuration@ "${BUILD_DIR}/etc/nixos/aster_configuration.nix"
    cp -r @aster-etc-nixos@/modules "${BUILD_DIR}/etc/nixos"
    cp -r @aster-etc-nixos@/overlays "${BUILD_DIR}/etc/nixos"

    COMMON_NIX_ARGS=(
        --option extra-substituters "@aster-substituters@"
        --option extra-trusted-public-keys "@aster-trusted-public-keys@"
    )

    NIX_SYSTEM="@aster-target-platform@"
    NIXPKGS_PATH="@aster-nixpkgs@"

    SYSTEM_CLOSURE=$(nix-build "${NIXPKGS_PATH}/nixos" -A system \
        --option extra-platforms "${NIX_SYSTEM}" \
        --argstr system "${NIX_SYSTEM}" \
        -I "nixos-config=${BUILD_DIR}/etc/nixos/configuration.nix" \
        "${COMMON_NIX_ARGS[@]}" \
        --no-out-link)

    export PATH=${PATH}:/run/current-system/sw/bin

    # Install the system manually rather than through `nixos-install`:
    # `nixos-install` invokes `nixos-enter`, whose `unshare --mount-proc`
    # is not available in unprivileged containers.
    nix-env --store "${BUILD_DIR}" \
        "${COMMON_NIX_ARGS[@]}" \
        --extra-substituters "auto?trusted=1" \
        -p "${BUILD_DIR}/nix/var/nix/profiles/system" \
        --set "${SYSTEM_CLOSURE}"

    # The activation script normally mounts /sys, /proc, and /run through its
    # `specialfs` snippet. Mounting sysfs/procfs is not permitted in this
    # unprivileged container, so patch that snippet out of the copy in the
    # target store before running activation.
    local ACTIVATE_PATH
    ACTIVATE_PATH="${BUILD_DIR}/nix/store/$(basename "${SYSTEM_CLOSURE}")/activate"
    chmod u+w "${ACTIVATE_PATH}"
    sed -i 's|^source /nix/store/.*-mounts.sh$|# &|' "${ACTIVATE_PATH}"

    # At boot, systemd mounts a fresh tmpfs on /run, which would hide the
    # /run/current-system symlink created by activation. Mount /run before
    # activation in the stage-2 init script so the symlink survives into
    # the running system.
    local INIT_PATH
    INIT_PATH="${BUILD_DIR}/nix/store/$(basename "${SYSTEM_CLOSURE}")/init"
    chmod u+w "${INIT_PATH}"
    awk '{
        print
        if ($0 == "echo \"running activation script...\"") {
            print "mkdir -p /run"
            print "mount -n -t tmpfs -o mode=755 tmpfs /run"
        }
    }' "${INIT_PATH}" > "${INIT_PATH}.tmp"
    chmod --reference="${INIT_PATH}" "${INIT_PATH}.tmp"
    mv "${INIT_PATH}.tmp" "${INIT_PATH}"

    mkdir -m 0755 -p "${BUILD_DIR}/etc"
    touch "${BUILD_DIR}/etc/NIXOS"
    ln -sfn /proc/mounts "${BUILD_DIR}/etc/mtab"
    mkdir -p "${BUILD_DIR}/run"

    mkdir -p "${BUILD_DIR}/dev" "${BUILD_DIR}/sys" "${BUILD_DIR}/proc"
    # The activation script only needs /dev/null during installation. A real
    # devtmpfs is mounted over /dev when the image boots.
    : > "${BUILD_DIR}/dev/null"
    chmod 666 "${BUILD_DIR}/dev/null"

    chroot "${BUILD_DIR}" /nix/var/nix/profiles/system/activate

    # Install GRUB manually. The NixOS `switch-to-configuration boot` helper
    # probes /dev/vda* block devices, which do not exist in a loop-free image
    # build, so create a standalone EFI image and a minimal grub.cfg directly.
    local KERNEL_PATH INITRD_PATH KERNEL_PARAMS
    KERNEL_PATH=$(chroot "${BUILD_DIR}" readlink -f /nix/var/nix/profiles/system/kernel)
    INITRD_PATH=$(chroot "${BUILD_DIR}" readlink -f /nix/var/nix/profiles/system/initrd)
    KERNEL_PARAMS=$(cat "${BUILD_DIR}/nix/var/nix/profiles/system/kernel-params")

    mkdir -p "${BUILD_DIR}/boot/grub" "${BUILD_DIR}/boot/EFI/BOOT"
    cat > "${BUILD_DIR}/boot/grub/grub.cfg" <<EOF
set default=0
set timeout=0
menuentry "Asterinas NixOS" {
    insmod part_gpt
    insmod ext2
    insmod fat
    insmod search
    insmod search_label
    search --no-floppy --set=root --label nixos
    linux ${KERNEL_PATH} ${KERNEL_PARAMS}
    initrd ${INITRD_PATH}
}
EOF

    grub-mkstandalone \
        --format=x86_64-efi \
        --output="${BUILD_DIR}/boot/EFI/BOOT/BOOTX64.EFI" \
        --modules="part_gpt ext2 fat normal linux nativedisk search search_label" \
        "boot/grub/grub.cfg=${BUILD_DIR}/boot/grub/grub.cfg"

    # Keep only the current system generation.
    nix-env --store "${BUILD_DIR}" \
        -p "${BUILD_DIR}/nix/var/nix/profiles/system" \
        --delete-generations old
    nix-store --store "${BUILD_DIR}" --gc

    # Put /boot on the ESP. The root filesystem keeps /boot only as a mount point.
    cp -a "${BUILD_DIR}/boot/." "${ESP_CONTENT_DIR}/"
    rm -rf "${BUILD_DIR}"/boot/*

    truncate -s "${ESP_SIZE}" "${ESP_IMG}"
    mkfs.fat -F 32 -n boot "${ESP_IMG}"
    (cd "${ESP_CONTENT_DIR}" && for entry in *; do
        [[ -e "${entry}" ]] || continue
        if [[ -d "${entry}" ]]; then
            mcopy -s -i "${ESP_IMG}" "${entry}" "::/${entry}"
        else
            mcopy -i "${ESP_IMG}" "${entry}" "::/${entry}"
        fi
    done)

    truncate -s "${ROOT_SIZE}" "${ROOT_IMG}"
    mkfs.ext2 -L nixos -d "${BUILD_DIR}" "${ROOT_IMG}"

    dd if="${ESP_IMG}" of="${IMAGE}" bs=512 seek=$((ESP_START / 512)) conv=notrunc status=none
    dd if="${ROOT_IMG}" of="${IMAGE}" bs=512 seek=$((ROOT_START / 512)) conv=notrunc status=none

    echo "Congratulations! Asterinas NixOS has been installed successfully!"
}

if [[ -n "$IMAGE" ]]; then
    install_to_image "$IMAGE" "$CONFIG_PATH"
    exit 0
fi

# When a tool below closes the disk after writing it, udevd asks the kernel
# to re-read the partition table. The re-read deletes and re-creates every
# partition device, so mkfs fails with ENOENT or ENXIO if it opens a
# partition in between, even though parted has already created it.
#
# udevd skips the re-read while another process holds a flock on the whole
# disk (https://systemd.io/BLOCK_DEVICE_LOCKING/), so hold one until both
# partitions are mounted. Open the disk read-only, because closing a
# writable fd would itself trigger a re-read.
exec 9<"${DISK}"
flock -x 9

# Confirm dangerous operation if --force-format-disk is used
if [[ "$FORCE_FORMAT_DISK" == true ]]; then
    echo "WARNING: You are about to FORMAT the disk: $DISK"
    sgdisk --zap-all $DISK
    partprobe $DISK
fi

BUILD_DIR=$(mktemp -d -p /mnt)

if [ "${DISK#/dev/loop}" != "$DISK" ]; then
    BOOT_DEVICE="${DISK}p1"
    ROOT_DEVICE="${DISK}p2"
else
    BOOT_DEVICE="${DISK}1"
    ROOT_DEVICE="${DISK}2"
fi
if [ ! -b "${BOOT_DEVICE}" ] && [ ! -b "${ROOT_DEVICE}" ]; then
    parted ${DISK} -- mklabel gpt
    parted ${DISK} -- mkpart ESP fat32 1MB 512MB
    parted ${DISK} -- mkpart root ext2 512MB 100%
    parted ${DISK} -- set 1 esp on
    echo "partition finished"

    mkfs.fat -F 32 -n boot "${BOOT_DEVICE}"
    mkfs.ext2 -L nixos "${ROOT_DEVICE}"
    echo "mkfs finished"
else
    echo "Partitions ${BOOT_DEVICE} and ${ROOT_DEVICE} already exist — skipping partitioning and mkfs"
fi

if findmnt -M ${BUILD_DIR}/boot >/dev/null; then
	umount -d ${BUILD_DIR}/boot
fi
if findmnt -M ${BUILD_DIR} >/dev/null; then
	umount -d ${BUILD_DIR}
fi

mkdir -p ${BUILD_DIR}
mount -t ext2 -o sync,dirsync "${ROOT_DEVICE}" ${BUILD_DIR}

mkdir -p ${BUILD_DIR}/boot
mkdir -p ${BUILD_DIR}/tmp
chmod 1777 ${BUILD_DIR}/tmp
mkdir -p ${BUILD_DIR}/etc/nixos
mount -o umask=077,sync,dirsync "${BOOT_DEVICE}" ${BUILD_DIR}/boot

# The kernel rejects a partition-table re-read with EBUSY while partitions
# are mounted, so the lock is no longer needed.
exec 9<&-

echo "${BUILD_DIR} is mounted successfully!"

cleanup() {
    umount -d ${BUILD_DIR}/boot 2>/dev/null || true
    umount -d ${BUILD_DIR} 2>/dev/null || true
    rm -rf ${BUILD_DIR}
}
trap cleanup EXIT INT TERM ERR

cp $CONFIG_PATH ${BUILD_DIR}/etc/nixos/configuration.nix
cp @aster-configuration@ ${BUILD_DIR}/etc/nixos/aster_configuration.nix
cp -r @aster-etc-nixos@/modules ${BUILD_DIR}/etc/nixos
cp -r @aster-etc-nixos@/overlays ${BUILD_DIR}/etc/nixos

COMMON_NIX_ARGS=(
    --option extra-substituters "@aster-substituters@"
    --option extra-trusted-public-keys "@aster-trusted-public-keys@"
)

NIX_SYSTEM="@aster-target-platform@"
NIXPKGS_PATH="@aster-nixpkgs@"

# Pre-build the NixOS system closure on the host
# so that the result is cached in the host's Nix store.
# Without this, nixos-install would build the system inside the (possibly empty) target image,
# causing redundant downloads after every `make clean`.
#
# See: https://www.mankier.com/8/nixos-install#--system
SYSTEM_CLOSURE=$(nix-build "${NIXPKGS_PATH}/nixos" -A system \
    --option extra-platforms "${NIX_SYSTEM}" \
    --argstr system "${NIX_SYSTEM}" \
    -I "nixos-config=${BUILD_DIR}/etc/nixos/configuration.nix" \
    "${COMMON_NIX_ARGS[@]}" \
    --no-out-link)

export PATH=${PATH}:/run/current-system/sw/bin
nixos-install --root ${BUILD_DIR} --no-root-passwd \
    --system "${SYSTEM_CLOSURE}" \
    "${COMMON_NIX_ARGS[@]}"

# Retain only the current system generation. Reusing the disk image otherwise
# preserves old system closures in its Nix store after every installation.
nix-env --store "${BUILD_DIR}" \
    -p "${BUILD_DIR}/nix/var/nix/profiles/system" \
    --delete-generations old
nix-store --store "${BUILD_DIR}" --gc
echo "Congratulations! Asterinas NixOS has been installed successfully!"
